# Supabase (https://supabase.com/dashboard → your project → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is used server-side only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies — REQUIRED for sign-in to work when Supabase is
# configured. Generate one with: openssl rand -hex 32
# Rotating it logs every member out at once.
SESSION_SECRET=

# When set, new accounts must supply this code (share it in the group chat).
# Leave empty to keep registration open.
CLUB_INVITE_CODE=

# Optional: powers password-reset emails (src/app/api/auth/forgot) and the
# daily reminder cron (src/app/api/cron/remind). Without RESEND_API_KEY,
# emails are logged to the server console instead of sent — safe to leave
# unset while developing locally.
# https://resend.com/api-keys
RESEND_API_KEY=
# "From" address for outgoing emails. Must be a verified Resend domain to
# reach recipients other than the account owner — the default
# onboarding@resend.dev only delivers to the Resend account's own email.
RESEND_FROM=Yoga Club <onboarding@resend.dev>

# Base URL used to build links in emails (e.g. https://yoga-club.vercel.app).
# Falls back to Vercel's own VERCEL_URL on deploy, then localhost:3000.
NEXT_PUBLIC_APP_URL=

# Optional: set this and Vercel Cron automatically sends it as a Bearer
# token when triggering /api/cron/remind, so the route can reject calls
# without it. Leave empty in local dev to hit the route manually.
CRON_SECRET=
